# EduSpeak AI - Cấu hình biến môi trường
# Sao chép file này thành .env và điền các giá trị thích hợp

# 1. Cổng máy chủ backend API proxy
PORT=3001

# 2. Khóa OpenAI API (Chỉ lưu ở Backend để bảo mật an toàn)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 3. URL kết nối Frontend đến Backend
VITE_API_URL=http://localhost:3001

# 4. Chế độ Mock AI (true: sử dụng AI giả lập thông minh không tốn token; false: gọi OpenAI thật)
VITE_USE_MOCK_AI=true
